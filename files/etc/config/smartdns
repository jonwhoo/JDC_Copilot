config smartdns 'smartdns'
    option enabled '1'
    option port '6053'
    option tcp_server '1'
    option dualstack_ip_selection '1'
    option serve_expired '1'
    option cache_size '10240'
    option rr_ttl_min '300'
    option rr_ttl_max '86400'
    option force_aaaa '0'

config server 'tencent'
    option enabled '1'
    option ip '119.29.29.29'
    option port '53'
    option type 'udp'

config server 'ali'
    option enabled '1'
    option ip '223.5.5.5'
    option port '53'
    option type 'udp'

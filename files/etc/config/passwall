config global
    option enabled '1'
    option tcp_node 'default_tcp'
    option udp_node 'default_udp'
    option dns_mode 'dns2socks'

config nodes 'default_tcp'
    option enabled '0'
    option type 'Xray'
    option protocol 'vmess'
    option address 'your-airport-host.com'
    option port '443'
    option tls '1'
    option transport 'ws'
    option ws_host 'your-airport-host.com'
    option ws_path '/path'
    option alter_id '0'
    option uuid 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'

config nodes 'default_udp'
    option enabled '0'
    option type 'Xray'
    option protocol 'trojan'
    option address 'your-airport-host.com'
    option port '443'
    option tls '1'
    option password 'your-password'
